<layout>
    <catalog_product_view>
        <reference name="head">
            <action method="addCss"><stylesheet>css/sizechart.css</stylesheet></action>
            <action method="addItem">
                <type>skin_js</type>
                <name>kalp/sizechart/sizechart.js</name>
            </action>
        </reference>
        <reference name="alert.urls">
            <block type="sizechart/product_view" name="sizechart.product.view" as="sizechart" template="kalp/sizechart/link.phtml" />
        </reference>
        <reference name="before_body_end">
            <block type="sizechart/product_view" name="sizechart.product.modal" template="kalp/sizechart/modal.phtml" />
        </reference>
    </catalog_product_view>
</layout>
